{
  "name": "biblioteca-reader",
  "private": true,
  "version": "0.1.17-SNAPSHOT",
  "releaseName": "Ethereal Exedra",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs && npm run test:bundle",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "test:e2e": "playwright test",
    "openapi:public:build": "node scripts/build-openapi-public.mjs",
    "openapi:sync": "node scripts/sync-textbase-openapi.mjs",
    "openapi:generate": "openapi-typescript openapi/reader-api.json -o src/generated/same-origin-api.d.ts",
    "openapi:update": "npm run openapi:public:build && npm run openapi:sync && npm run openapi:generate",
    "test:bundle": "node scripts/test-server-bundle.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "1.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minio": "^8.0.7",
    "motion": "^12.23.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.6.1",
    "swagger-ui-express": "^5.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
