# The complete set of environment variables the reader uses - DUMMY values
# only, the shape of the contract, never real ones. Real values come from
# the pass store (biblioteca/<stage> via load-env.sh, loaded by the rake
# tasks); Stripe is intentionally unconfigured (see server.ts).

# BIBLIOTECA_EXTERNAL_URL: the biblioteca-server this reader fronts - the
# server's own advertised URL, the same value the whole Biblioteca family
# shares from the pass store.
BIBLIOTECA_EXTERNAL_URL=http://biblioteca.local:8080

# PORT: the reader's own port (dev default; deployments override it).
PORT=3333

# VITE_GOOGLE_CLIENT_ID: Google OAuth client id for the One Tap widget,
# baked in at BUILD time by Vite. The rakefile maps it automatically from
# the pass store's GOOGLE_OAUTH_CLIENT_ID (which must equal the server's
# own google.oauth.client-id); set it manually only for bare npm commands.
VITE_GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com

# Optional server-side cover cache. The bucket is public-read, but these are
# write credentials for the dedicated cover-cache account and must come from
# the pass store, never from the browser or a committed .env file.
MINIO_URL=http://srv2.local:20124/biblioteca
MINIO_CREDS=dummy-cover-cache-access-key:dummy-cover-cache-secret-key
